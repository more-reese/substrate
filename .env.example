# substrate does not load a .env file. Export these in your shell before running:
#   export ANTHROPIC_API_KEY=...
# The model id lives in config.py (MODEL_ID), or pass --model on the command line.

# Optional. Enables Claude-based parsing. Without it (or with --dry-run) the
# rule-based offline parser is used.
ANTHROPIC_API_KEY=

# Optional alternative to ANTHROPIC_API_KEY: a bearer token the Anthropic SDK accepts.
# ANTHROPIC_AUTH_TOKEN=
